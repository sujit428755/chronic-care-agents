# Copy this file to ".env" and fill in your values. NEVER commit the real .env file.

# --- Agent Framework (specialist agents) - same names as the reference demos ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- Foundry project (Education RAG agent) - same names as the reference agent_v2.py ---
FOUNDRY_PROJECT_ENDPOINT=
MODEL_DEPLOYMENT_NAME=
TEXT_EMBEDDING_MODEL_NAME=

# --- Azure AI Search ---
SEARCH_SERVICE_ENDPOINT=
AI_SEARCH_CONNECTION_NAME=
# Optional. Leave empty to authenticate with `az login` instead of a key.
SEARCH_API_KEY=
# Optional. Size of the embedding vectors. Leave empty: 3072 for text-embedding-3-large, otherwise 1536.
EMBEDDING_DIMENSIONS=
# vector_semantic_hybrid (default) | semantic | simple. Use "semantic" if the agent search tool complains about vectors.
SEARCH_QUERY_TYPE=vector_semantic_hybrid
SEARCH_INDEX_EDU=edu-articles
SEARCH_INDEX_FAQ=program-faqs
SEARCH_INDEX_CAREPLAN=careplan-guidance

# --- SWITCHES: change these if something goes wrong (see docs/CONCEPTS_AND_RUN_GUIDE.md, section B) ---
# foundry   = all six agents are Foundry agents (visible in the Foundry portal).  framework = specialists run in Python.
AGENT_RUNTIME=foundry
# index = Azure AI Search tool (default, most robust).  knowledge_base = Foundry knowledge base on Blob Storage (MCP tool).
EDUCATION_RETRIEVAL=index
# Only for knowledge_base mode: knowledge base name, project connection name (defaults to AI_SEARCH_CONNECTION_NAME),
# and the indexer names created by your knowledge sources (comma separated, optional).
KNOWLEDGE_BASE_NAME=
SEARCH_SERVICE_PROJECT_CONNECTION_NAME=
KNOWLEDGE_INDEXERS=
# Preview API version of the knowledge base endpoint. Default = the reference version. If Microsoft's docs show a newer one
# (for example 2026-08-01-preview) and the default fails, put the newer value here (check docs).
KNOWLEDGE_BASE_API_VERSION=2025-11-01-preview
# 1 = create / update the six agents in Foundry when the app, client or test runner starts
AUTO_REGISTER_AGENTS=1

# --- Azure Blob Storage (the cloud copy of the data tables and documents) ---
# Option A: key string. Azure portal > Storage account > Access keys > Connection string.
AZURE_STORAGE_CONNECTION_STRING=
# Option B: no key. Use the account URL and sign in with `az login` (needs the "Storage Blob Data Contributor" role).
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=chronic-care-data
# 1 = every save in the Data Manager is uploaded to Blob Storage at once (if Blob is configured)
AUTO_UPLOAD=1
# 1 = after the upload also rebuild the search indexes (index mode) or run the knowledge-source indexers (knowledge_base mode)
AUTO_SYNC=0
# 1 = download the latest files from Blob Storage when the app starts (shared copy for the team)
PULL_ON_START=0
# Upload size limit in the Data Manager (MB)
MAX_UPLOAD_MB=5

# --- App behaviour ---
# "Today" for the synthetic data (keeps demo and tests repeatable)
REFERENCE_DATE=2026-10-07
# 1 = run without any Azure/model calls (templates only). 0 = use Foundry agents.
OFFLINE=0
# For the tool-failure test only. Allowed values: readings, careplan, members, or leave empty.
SIMULATE_TOOL_FAILURE=
